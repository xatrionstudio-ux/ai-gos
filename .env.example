# ──────────────────────────────────────────────────────────────────────────────
# AI Growth Operating System — Environment Variables
# Copy this file to .env and fill in all values before starting services.
# NEVER commit the actual .env file.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development           # development | staging | production
DEBUG=false
APP_NAME="AI Growth Operating System"
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ─── Security (REQUIRED — no defaults in production) ─────────────────────────
# Generate with: openssl genrsa -out jwt_private.pem 4096
# Run: make keys
JWT_PRIVATE_KEY_PATH=infrastructure/keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=infrastructure/keys/jwt_public.pem
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# CSRF double-submit cookie secret (min 32 bytes random)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
CSRF_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_64_HEX_CHARS

# Encryption key for at-rest sensitive fields (Fernet)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aigos
POSTGRES_USER=aigos
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DATABASE_URL=postgresql+asyncpg://aigos:REPLACE_WITH_STRONG_PASSWORD@localhost:5432/aigos
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3

# ─── Vector Store (Qdrant) ────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=REPLACE_WITH_QDRANT_API_KEY_IN_PRODUCTION
QDRANT_COLLECTION_PREFIX=aigos

# ─── AI Providers ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=REPLACE_WITH_OPENAI_KEY
ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_KEY
GOOGLE_AI_API_KEY=REPLACE_WITH_GOOGLE_AI_KEY

# LiteLLM proxy (if using)
LITELLM_PROXY_URL=
LITELLM_PROXY_API_KEY=

# Default model per role
LLM_DEFAULT_MODEL=gpt-4o
LLM_FAST_MODEL=gpt-4o-mini
LLM_RESEARCH_MODEL=claude-3-5-sonnet-20241022
LLM_EMBEDDING_MODEL=text-embedding-3-large

# ─── Search APIs ──────────────────────────────────────────────────────────────
SERPER_API_KEY=REPLACE_WITH_SERPER_KEY
BRIGHTDATA_API_KEY=REPLACE_WITH_BRIGHTDATA_KEY
YOUTUBE_API_KEY=REPLACE_WITH_YOUTUBE_KEY

# ─── Analytics Integrations ───────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_JSON=REPLACE_WITH_BASE64_ENCODED_SERVICE_ACCOUNT_JSON

# ─── CMS Adapters ─────────────────────────────────────────────────────────────
# WordPress
WORDPRESS_DEFAULT_URL=
WORDPRESS_DEFAULT_USER=
WORDPRESS_DEFAULT_APP_PASSWORD=

# Ghost
GHOST_DEFAULT_URL=
GHOST_DEFAULT_ADMIN_KEY=

# ─── Observability ────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=ai-gos-api
OTEL_ENVIRONMENT=development

# LangSmith (optional — for LangGraph tracing)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-gos
LANGCHAIN_TRACING_V2=false

# ─── Email (Notifications) ────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@yourdomain.com
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=AI-GOS <notifications@yourdomain.com>

# ─── Storage ──────────────────────────────────────────────────────────────────
STORAGE_BACKEND=local           # local | s3 | gcs
STORAGE_LOCAL_PATH=/data/uploads
# S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_BURST=20

# ─── Billing ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="AI-GOS"
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
