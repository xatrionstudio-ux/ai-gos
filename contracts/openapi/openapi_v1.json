{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Growth Operating System (AGOS) Gateway API",
    "version": "1.0.0",
    "description": "Unified OpenAPI 3.1 specification for AGOS microservices."
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "summary": "Authenticate user credentials",
        "responses": {
          "200": { "description": "Tokens issued" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/api/v1/projects": {
      "get": {
        "summary": "List tenant projects",
        "responses": {
          "200": { "description": "Project list page" }
        }
      },
      "post": {
        "summary": "Create a new SaaS project profile",
        "responses": {
          "201": { "description": "Project created" }
        }
      }
    },
    "/api/v1/knowledge/search": {
      "post": {
        "summary": "Hybrid RAG search across PKL",
        "responses": {
          "200": { "description": "Evidence Pack returned" }
        }
      }
    },
    "/api/v1/workflows/start": {
      "post": {
        "summary": "Start an AGOS workflow",
        "responses": {
          "202": { "description": "Workflow initiated" }
        }
      }
    }
  }
}
